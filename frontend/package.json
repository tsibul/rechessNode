{
  "name": "rechess-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev_ssg": "vite-ssg build && vite preview --port 3000",
    "build": "vite-ssg build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "lint": "eslint src build --ext .ts && node scripts/check-vue-docs.mjs",
    "docs": "npm run docs:lint && npm run docs:ts && npm run docs:vue",
    "docs:ts": "typedoc",
    "docs:vue": "node scripts/gen-vue-docs.mjs",
    "docs:lint": "npm run lint"
  },
  "dependencies": {
    "@types/js-cookie": "^3.0.6",
    "@unhead/vue": "^2.0.12",
    "@vueuse/components": "^13.5.0",
    "@vueuse/core": "^10.9.0",
    "axios": "^1.6.7",
    "dompurify": "^3.4.17",
    "js-cookie": "^3.0.5",
    "pinia": "^2.1.7",
    "vite-ssg": "^28.0.0",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/compiler-sfc": "^3.5.17",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.4",
    "eslint": "^8.57.0",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-vue": "^9.22.0",
    "sass": "^1.63.6",
    "typedoc": "^0.28.20",
    "typescript": "^5.3.3",
    "vite": "^7.0.4",
    "vite-plugin-pages": "^0.33.1",
    "vitest": "^3.2.4",
    "vue-docgen-api": "^4.79.2",
    "vue-tsc": "^3.0.1"
  }
}
