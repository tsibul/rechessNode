{
  "name": "rechess-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev_ssg": "vite-ssg build && vite preview --port 3000",
    "build": "vite-ssg build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "lint": "eslint src build && node scripts/check-vue-docs.mjs",
    "docs": "npm run docs:lint && npm run docs:ts && npm run docs:vue",
    "docs:ts": "typedoc",
    "docs:vue": "node scripts/gen-vue-docs.mjs",
    "docs:lint": "npm run lint"
  },
  "dependencies": {
    "@types/js-cookie": "^3.0.6",
    "@unhead/vue": "^2.0.12",
    "@vueuse/components": "^13.5.0",
    "@vueuse/core": "^10.9.0",
    "axios": "^1.6.7",
    "dompurify": "^3.4.17",
    "js-cookie": "^3.0.5",
    "pinia": "^2.1.7",
    "vite-ssg": "^28.0.0",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/compiler-sfc": "^3.5.17",
    "@vue/test-utils": "~2.4.11",
    "eslint": "^9.39.5",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-vue": "^10.12.0",
    "sass": "^1.63.6",
    "typedoc": "^0.28.20",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.0.4",
    "vite-plugin-pages": "^0.33.1",
    "vitest": "^5.1.0",
    "vue-docgen-api": "^4.79.2",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.0.1"
  },
  "overrides": {
    "minimatch@>=7": "^11.0.5",
    "glob@>=9": "^14.0.4",
    "typedoc": {
      "minimatch": "10.2.6"
    }
  }
}
