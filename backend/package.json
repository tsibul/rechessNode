{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage",
    "migrate": "knex migrate:latest",
    "seed": "knex seed:run",
    "create-admin": "ts-node src/scripts/create-admin.ts",
    "docs": "npm run docs:lint && npm run docs:ts && npm run docs:openapi",
    "docs:ts": "typedoc",
    "docs:openapi": "ts-node src/scripts/generate-openapi.ts",
    "docs:lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.3.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "multer": "^2.5.0",
    "mysql2": "^3.9.1",
    "nodemailer": "^10.3.1",
    "sanitize-html": "2.17.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.10",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-plugin-jsdoc": "^65.4.5",
    "jest": "^29.7.0",
    "nodemon": "^3.0.3",
    "supertest": "^7.1.3",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.20",
    "typescript": "^5.3.3"
  }
}
