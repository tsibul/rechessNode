# Copy to backend/.env and fill in. Secrets stay out of git.

# Database (MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_USER=rechess
DB_PASSWORD=
DB_NAME=rechess

# CMS sessions
JWT_SECRET=change-me
JWT_EXPIRES_IN=12h

# Server
PORT=3001
FRONTEND_URL=http://localhost:3000

# Mail (stage 8). Without SMTP_HOST nothing is sent: each mail is written as an .eml file
# into MAIL_OUTBOX_DIR (default backend/outbox). The sender name comes from the CMS setting mail.from_name.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (port 465); empty: decided by the port
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_OUTBOX_DIR=

# Rebuild on "Publish" in the CMS. Run from the backend directory.
PUBLISH_COMMAND=node ../frontend/scripts/publish.mjs
# Kill the build after this many ms (default 15 minutes).
PUBLISH_TIMEOUT_MS=900000
# Where releases/<stamp> and the `current` symlink go (default: <repo>/site).
# PUBLISH_TARGET=
# API the build reads content from (default http://localhost:3001).
# API_URL=
# Releases kept after a successful publish (default 3).
# KEEP_RELEASES=3

# Payment (stage 11). One of: none | stub. Empty = none (order only, no payment step).
# stub: a test page "paid / declined", no money moves; development and tests only.
# In production (NODE_ENV=production) only a real provider is accepted: with none, stub or empty
# the order is refused with 503 "payment unavailable". A real service is a new implementation of
# PaymentProvider in src/services/payment, registered in index.ts, selected by its code here.
PAYMENT_PROVIDER=stub

# Server binding and proxy (security). On the server set HOST=127.0.0.1: the backend is then reachable only
# through nginx on the same machine (unset: all addresses). TRUST_PROXY: which hops may set
# X-Forwarded-For (default "loopback": a client that reaches the backend directly cannot fake its address).
# nginx must send `proxy_set_header X-Forwarded-For $remote_addr;`.
# HOST=127.0.0.1
# TRUST_PROXY=loopback
# Production: NODE_ENV=production, JWT_SECRET of 32+ random characters and an https FRONTEND_URL
# are required, otherwise the server does not start. The dev seed refuses non-local DB hosts.
